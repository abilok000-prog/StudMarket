{
  "name": "studmarket",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "app:sync": "vite build && cap sync",
    "app:android": "vite build && cap sync android && cap open android",
    "app:ios": "vite build && cap sync ios && cap open ios",
    "app:icons": "node scripts/make-icons.mjs && capacitor-assets generate --ios --android --iconBackgroundColor #5b5bf0 --splashBackgroundColor #5b5bf0 --splashBackgroundColorDark #0d0e14"
  },
  "dependencies": {
    "@capacitor/android": "6.1.2",
    "@capacitor/core": "6.1.2",
    "@capacitor/ios": "6.1.2",
    "@capacitor/splash-screen": "6.0.2",
    "@capacitor/status-bar": "6.0.1",
    "@neondatabase/auth": "0.7.0-beta",
    "html5-qrcode": "2.3.8",
    "qrcode.react": "4.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "6.1.2",
    "@vitejs/plugin-react": "4.3.4",
    "vite": "5.4.11"
  }
